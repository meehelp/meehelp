{
  "name": "meehelp-website-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MeeHelp Website V2 — SEO-first static marketing site. Independent of production systems.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "SITE_STAGE=preview astro build",
    "build:production": "SITE_STAGE=production astro build",
    "serve": "node scripts/serve-static.mjs",
    "typecheck": "astro check",
    "test": "tsx --test tests/unit/*.test.ts",
    "seo": "tsx scripts/seo-check.ts",
    "seo:preview": "tsx scripts/seo-check.ts --stage=preview",
    "measure:js": "node scripts/measure-js.mjs",
    "check": "npm run typecheck && npm test && npm run seo && npm run seo:preview && npm run seo:release-review",
    "intent-map": "tsx scripts/intent-map.ts",
    "report": "tsx scripts/content-report.ts",
    "evidence": "tsx scripts/evidence.ts",
    "build:release-review": "SITE_STAGE=release-review astro build",
    "seo:release-review": "tsx scripts/seo-check.ts --stage=release-review",
    "release-docs": "tsx scripts/release-docs.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "node-html-parser": "9.0.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "astro": "7.3.5"
  }
}
