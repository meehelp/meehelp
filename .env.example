# MeeHelp Website V2 — environment variable NAMES only. Never commit values.
# Copy to .env.local for local overrides. All variables are read at BUILD time.

# Build stage: development | preview | production
# Anything other than "production" is noindex + robots "Disallow: /".
SITE_STAGE=

# Canonical origin, no trailing slash. Defaults to https://meehelp.in
SITE_URL=

# Analytics — leave empty until IDs are approved. Nothing loads while empty.
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# Search Console HTML-tag verification token (content value only).
# Prefer DNS (Domain property) verification; leave empty if using DNS.
GOOGLE_SITE_VERIFICATION=
