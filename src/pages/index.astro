---
/**
 * The home page introduces BOTH propositions and makes the choice obvious:
 * find and hire a helper directly (marketplace) or book help by the hour
 * (on-demand). Each proposition's sections are marked with data-model; the
 * SEO validator checks that their wording and CTAs never mix.
 *
 * Links appear only for pages built for the current stage.
 */
import { businessModels } from "@/data/business-models";
import { schemaSettings } from "@/data/business";
import { cities } from "@/data/cities";
import { home } from "@/data/home";
import { marketplaceSteps, onDemandSteps } from "@/data/how-it-works";
import AppDownloadSection from "@/components/app/AppDownloadSection.astro";
import StoreButtons from "@/components/app/StoreButtons.astro";
import BookingTypes from "@/components/content/BookingTypes.astro";
import Cta from "@/components/content/Cta.astro";
import FaqList from "@/components/content/FaqList.astro";
import Icon from "@/components/content/Icon.astro";
import Section from "@/components/content/Section.astro";
import Steps from "@/components/content/Steps.astro";
import PlansSummary from "@/components/pricing/PlansSummary.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Claims from "@/components/trust/Claims.astro";
import Safeguards from "@/components/trust/Safeguards.astro";
import Testimonials from "@/components/trust/Testimonials.astro";
import TrustMetrics from "@/components/trust/TrustMetrics.astro";
import VerificationSummary from "@/components/trust/VerificationSummary.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getServiceCategories } from "@/lib/content";
import { isIndexable } from "@/lib/content/publishing";
import { buildPageMetadata } from "@/lib/seo/metadata";
import { faqPageSchema, organizationSchema, websiteSchema } from "@/lib/seo/schema";

const meta = buildPageMetadata({ ...home.seo, path: "/", indexable: isIndexable(home.publishStatus) });

const hire = getServiceCategories(undefined, "marketplace");
const book = getServiceCategories(undefined, "onDemand");
const categories = hire.map((h, i) => ({ service: h.service, hireHref: h.href, bookHref: book[i]?.href ?? null }));
const activeCities = cities.filter((c) => c.marketActive === true);
const { marketplace, onDemand } = businessModels;

/**
 * Phase 4.5 linking review: the home page links to the 10 hubs (path cards
 * and category grid) and pricing. City pages are reached from their hub, so
 * no single category is promoted city by city from the home page.
 */
const schema = [organizationSchema(), websiteSchema(), ...(schemaSettings.faqPage ? [faqPageSchema(home.faqs)] : [])];
---

<BaseLayout meta={meta}>
  <JsonLd data={schema} />

  <section class="hero">
    <div class="container">
      <p class="eyebrow">Help at home with the MeeHelp app</p>
      <h1>{home.headline}</h1>
      <p class="lead">{home.intro}</p>
      <ul class="paths">
        {
          marketplace.confirmed ? (
            <li class="path" data-model="marketplace">
              <h2 class="path__title">{marketplace.name}</h2>
              <p>{marketplace.summary}</p>
              {hire.some((c) => c.href) ? (
                <ul class="path__links" aria-label="Find and hire">
                  {hire.filter((c) => c.href).map((c) => (
                    <li>
                      <a href={c.href!}>{c.service.shortName}</a>
                    </li>
                  ))}
                </ul>
              ) : null}
              <Cta ctaKey="findHelpers" placement="home_hero_marketplace" />
            </li>
          ) : null
        }
        {
          onDemand.confirmed ? (
            <li class="path path--alt" data-model="onDemand">
              <h2 class="path__title">{onDemand.name}</h2>
              <p>{onDemand.summary}</p>
              {book.some((c) => c.href) ? (
                <ul class="path__links" aria-label="Book by the hour">
                  {book.filter((c) => c.href).map((c) => (
                    <li>
                      <a href={c.href!}>{c.service.onDemand.shortName}</a>
                    </li>
                  ))}
                </ul>
              ) : null}
              <Cta ctaKey="bookNow" placement="home_hero_on_demand" />
            </li>
          ) : null
        }
      </ul>
      <StoreButtons placement="home_hero" />
    </div>
  </section>

  <Section id="categories" title="Choose the help you need" intro="Every category can be hired directly or booked by the hour.">
    <ul class="category-grid">
      {
        categories.map(({ service, hireHref, bookHref }) => (
          <li class="category">
            <span class="service-card__icon">
              <Icon name={service.icon} size={28} />
            </span>
            <h3 class="category__title">{service.name}</h3>
            <p class="category__text">{service.summary}</p>
            {hireHref || bookHref ? (
              <ul class="category__links">
                {hireHref ? (
                  <li>
                    <a href={hireHref}>
                      Find and hire<span class="visually-hidden"> {service.roleWithArticle}</span>
                    </a>
                  </li>
                ) : null}
                {bookHref ? (
                  <li>
                    <a href={bookHref}>
                      Book by the hour<span class="visually-hidden">: {service.onDemand.name}</span>
                    </a>
                  </li>
                ) : null}
              </ul>
            ) : null}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="how-hiring-works" title="How finding and hiring a helper works" tone="tint" model="marketplace">
    <Steps steps={marketplaceSteps} />
    <div class="cta-row">
      <Cta ctaKey="findHelpers" placement="home_how_hiring_works" />
    </div>
  </Section>

  <Section id="plans" title="Plans for contacting helpers" tone="warm" model="marketplace">
    <Claims model="marketplace" />
    <PlansSummary placement="home_plans" />
  </Section>

  {
    onDemand.confirmed ? (
      <Section id="on-demand" title="How booking by the hour works" intro={onDemand.summary} model="onDemand">
        <BookingTypes />
        <Steps steps={onDemandSteps} />
        <div class="cta-row">
          <Cta ctaKey="bookNow" placement="home_on_demand" />
        </div>
      </Section>
    ) : null
  }

  {
    activeCities.length > 0 ? (
      <Section id="coverage" title="Cities where MeeHelp operates" tone="tint">
        <ul class="city-list">
          {activeCities.map((city) => (
            <li class="city-list__item">
              <h3 class="city-list__name">
                <Icon name="arrow" size={16} class="city-list__icon" /> {city.displayName}
              </h3>
            </li>
          ))}
        </ul>
        <p>Every category is available in all eight cities. The app checks your address when you search or book, and each service page links to its city pages.</p>
      </Section>
    ) : null
  }

  <Section id="safety" title="Helper verification and safety">
    <TrustMetrics />
    <VerificationSummary />
    <h3>Tips for hiring or booking</h3>
    <Safeguards />
  </Section>

  <Testimonials />

  <AppDownloadSection model="both" placement="home_app_section" />

  <Section id="faqs" title="Frequently asked questions">
    <FaqList faqs={home.faqs} />
  </Section>

  <section class="cta-band" aria-labelledby="final-cta-heading">
    <div class="container">
      <h2 id="final-cta-heading">Get help at home with MeeHelp</h2>
      <p>Find and hire a helper directly, or book help by the hour — both in the MeeHelp app.</p>
      <StoreButtons placement="home_final_cta" align="center" />
    </div>
  </section>
</BaseLayout>
