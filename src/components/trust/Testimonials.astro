---
/**
 * Customer testimonials. Placeholders are visible (and clearly labelled) on
 * development/preview builds only. Renders nothing when there are none.
 * Deliberately has no Review/AggregateRating schema.
 */
import { cityName, getService, getVisibleTestimonials } from "@/lib/content";
import type { BusinessModel, ServiceSlug } from "@/lib/content/types";

interface Props {
  service?: ServiceSlug;
  model?: BusinessModel;
  title?: string;
}

const { service, model, title = "What customers say" } = Astro.props;
const items = getVisibleTestimonials()
  .filter((t) => !service || !t.service || t.service === service)
  .filter((t) => !model || !t.model || t.model === model);
---

{
  items.length > 0 ? (
    <section aria-labelledby="testimonials-heading" class="section">
      <div class="container">
        <h2 id="testimonials-heading" class="section__title">
          {title}
        </h2>
        <ul class="cards cards--2">
          {items.map((t) => (
            <li class={`card testimonial${t.isPlaceholder ? " testimonial--placeholder" : ""}`}>
              {t.isPlaceholder ? <p class="badge">Development placeholder — not published</p> : null}
              <blockquote>
                <p>{t.quote}</p>
              </blockquote>
              <p class="testimonial__by">
                {t.displayName}
                {t.service ? ` · ${getService(t.service)?.shortName}` : ""}
                {t.city ? ` · ${cityName(t.city)}` : ""}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null
}
