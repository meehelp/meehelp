---
/** Renders schema.org JSON-LD. `<` is escaped so content can never close the script tag. No runtime JS. */
type JsonLdData = Record<string, unknown>;

interface Props {
  data: JsonLdData | JsonLdData[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---

{items.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, "\\u003c")} />)}
