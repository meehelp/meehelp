---
/** Marketplace service hub (/maid/): find helpers, contact them and hire directly. */
import { schemaSettings } from "@/data/business";
import { marketplaceSteps } from "@/data/how-it-works";
import AppDownloadSection from "@/components/app/AppDownloadSection.astro";
import ArrangementList from "@/components/content/ArrangementList.astro";
import BulletList from "@/components/content/BulletList.astro";
import CheckList from "@/components/content/CheckList.astro";
import CrossLink from "@/components/content/CrossLink.astro";
import Cta from "@/components/content/Cta.astro";
import FaqList from "@/components/content/FaqList.astro";
import Icon from "@/components/content/Icon.astro";
import LinkList from "@/components/content/LinkList.astro";
import ProductFacts from "@/components/content/ProductFacts.astro";
import { factsFor } from "@/data/product-facts";
import Section from "@/components/content/Section.astro";
import ServiceCards from "@/components/content/ServiceCards.astro";
import Steps from "@/components/content/Steps.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import PlansSummary from "@/components/pricing/PlansSummary.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Claims from "@/components/trust/Claims.astro";
import Safeguards from "@/components/trust/Safeguards.astro";
import Testimonials from "@/components/trust/Testimonials.astro";
import VerificationSummary from "@/components/trust/VerificationSummary.astro";
import { cityName, getBuiltServiceCities, getServiceCategories, serviceHubStatus } from "@/lib/content";
import { serviceCityPath, servicePath } from "@/lib/content/paths";
import { isBuilt } from "@/lib/content/publishing";
import type { ResolvedRoute } from "@/lib/content/resolve";
import { faqPageSchema, serviceSchema } from "@/lib/seo/schema";

interface Props {
  route: Extract<ResolvedRoute, { kind: "service" }>;
}

const { service } = Astro.props.route;
const path = servicePath(service.slug);
const cityPages = getBuiltServiceCities(undefined, "marketplace").filter((sc) => sc.service === service.slug);
const related = getServiceCategories().filter((c) => c.service.slug !== service.slug && c.href);
const onDemandBuilt = isBuilt(serviceHubStatus(service, "onDemand"));
const appFacts = factsFor(service.slug, "marketplace");
const schema = [
  ...(schemaSettings.service ? [serviceSchema({ service, path, name: service.name, description: service.seo.description })] : []),
  ...(schemaSettings.faqPage ? [faqPageSchema(service.faqs)] : []),
];
---

<Breadcrumbs items={[{ name: "Home", path: "/" }, { name: service.name, path }]} />
<JsonLd data={schema} />

<div data-model="marketplace">
  <section class="hero hero--compact">
    <div class="container">
      <span class="hero__icon"><Icon name={service.icon} size={36} /></span>
      <p class="eyebrow">Find and hire directly</p>
      <h1>{service.headline}</h1>
      {service.description.map((p) => <p class="lead">{p}</p>)}
      <div class="cta-row">
        <Cta ctaKey="findService" role={service.roleWithArticle} placement={`${service.slug}_hero`} />
        <a class="text-link" href="#plans">See plans</a>
      </div>
    </div>
  </section>

  <Section id="situations" title="When families look for this help">
    <BulletList items={service.customerProblems} />
  </Section>

  <Section id="tasks" title={`What ${service.roleWithArticle} can help with`} tone="tint">
    <div class="two-col">
      <div>
        <h3>Usually included</h3>
        <CheckList items={service.tasksIncluded} />
      </div>
      <div>
        <h3>Usually not included</h3>
        <CheckList items={service.tasksExcluded} variant="cross" />
      </div>
    </div>
    <p class="note">Every home is different. Agree the exact tasks with the helper before they start.</p>
  </Section>

  <Section id="how-it-works" title={`How to find and hire ${service.roleWithArticle} on MeeHelp`}>
    <Steps steps={marketplaceSteps} />
  </Section>

  <Section id="in-the-app" title="What you see and choose in the app" tone="tint">
    <ProductFacts facts={appFacts} />
  </Section>

  <Section id="plans" title="Plans for contacting helpers" tone="warm">
    <Claims model="marketplace" />
    <PlansSummary placement={`${service.slug}_plans`} />
  </Section>

  <Section id="arrangements" title="Arrangements you can agree with a helper">
    <ArrangementList keys={service.arrangements} />
  </Section>

  <Section id="hiring-safely" title="Hiring safely" tone="tint">
    <VerificationSummary />
    <h3>Tips for hiring</h3>
    <Safeguards extra={service.safeguards} />
  </Section>

  {
    cityPages.length > 0 ? (
      <Section id="cities" title={`Find ${service.roleWithArticle} in your city`}>
        <LinkList
          label={`${service.name} by city`}
          links={cityPages.map((sc) => ({
            href: serviceCityPath(sc.service, sc.city),
            label: `${service.shortName} in ${cityName(sc.city)}`,
          }))}
        />
      </Section>
    ) : null
  }

  <Testimonials service={service.slug} model="marketplace" />

  <Section id="faqs" title={`${service.name}: frequently asked questions`}>
    <FaqList faqs={service.faqs} />
  </Section>
</div>

{
  onDemandBuilt ? (
    <CrossLink
      targetModel="onDemand"
      href={servicePath(service.slug, "onDemand")}
      heading="Only need help for a few hours?"
      body={`If you don't need a regular arrangement, you can book ${service.onDemand.bookingNoun} through the MeeHelp app instead.`}
      label={`${service.onDemand.name}: ${service.onDemand.bookNow ? "book now or schedule" : "schedule a booking"}`}
    />
  ) : null
}

<div data-model="marketplace">
  <AppDownloadSection
    model="marketplace"
    placement={`${service.slug}_app_section`}
    title={`Find ${service.roleWithArticle} in the MeeHelp app`}
  />

  {
    related.length > 0 ? (
      <Section id="related" title="Find other helpers" boilerplate>
        <ServiceCards items={related} />
      </Section>
    ) : null
  }
</div>
