---
/**
 * Marketplace service × city page (/maid/mumbai/). The substance is the
 * city-specific material (local notes, requirements, FAQs); shared
 * explanations stay brief and link to the service hub.
 */
import { schemaSettings } from "@/data/business";
import { marketplaceSteps } from "@/data/how-it-works";
import AppDownloadSection from "@/components/app/AppDownloadSection.astro";
import BulletList from "@/components/content/BulletList.astro";
import CrossLink from "@/components/content/CrossLink.astro";
import Cta from "@/components/content/Cta.astro";
import FaqList from "@/components/content/FaqList.astro";
import LinkList from "@/components/content/LinkList.astro";
import Section from "@/components/content/Section.astro";
import StepsInline from "@/components/content/StepsInline.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import PlansLine from "@/components/pricing/PlansLine.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import VerificationSummary from "@/components/trust/VerificationSummary.astro";
import { cityName, getBuiltServiceCities, getService, serviceCityStatus, getServiceCity } from "@/lib/content";
import { serviceCityPath, servicePath } from "@/lib/content/paths";
import { isBuilt } from "@/lib/content/publishing";
import type { ResolvedRoute } from "@/lib/content/resolve";
import { faqPageSchema, serviceSchema } from "@/lib/seo/schema";

interface Props {
  route: Extract<ResolvedRoute, { kind: "service-city" }>;
}

const { page, service, city, content } = Astro.props.route;
const path = serviceCityPath(page.service, page.city);
const built = getBuiltServiceCities(undefined, "marketplace");
const otherServicesHere = built.filter((sc) => sc.city === city.slug && sc.service !== service.slug);
const sameServiceElsewhere = built.filter((sc) => sc.service === service.slug && sc.city !== city.slug);
const counterpart = getServiceCity(service.slug, city.slug, "onDemand");
const counterpartBuilt = counterpart ? isBuilt(serviceCityStatus(counterpart)) : false;
const placement = `${service.slug}_${city.slug}`;
const schema = [
  ...(schemaSettings.service
    ? [serviceSchema({ service, path, city, name: `${service.name} in ${city.name}`, description: content.seo.description })]
    : []),
  ...(schemaSettings.faqPage ? [faqPageSchema(content.localFaqs)] : []),
];
---

<Breadcrumbs
  items={[
    { name: "Home", path: "/" },
    { name: service.name, path: servicePath(service.slug) },
    { name: city.name, path },
  ]}
/>
<JsonLd data={schema} />

<div data-model="marketplace">
  <section class="hero hero--compact">
    <div class="container">
      <p class="eyebrow">{service.name} · {city.displayName}</p>
      <h1>{content.headline}</h1>
      {content.introduction.map((para) => <p class="lead">{para}</p>)}
      <div class="cta-row">
        <Cta ctaKey="findService" role={service.roleWithArticle} placement={`${placement}_hero`} />
        <a class="text-link" href="#plans">See plans</a>
      </div>
    </div>
  </section>

  {
    content.localNotes.length > 0 ? (
      <Section id="local-info" title={`Hiring in ${city.name}: good to know`} tone="warm">
        <BulletList items={content.localNotes} />
      </Section>
    ) : null
  }

  <Section id="requirements" title={`What ${city.name} households usually ask for`}>
    <BulletList items={content.points} />
    <p class="note">
      For what {service.roleWithArticle} usually does and doesn't do, see <a href={servicePath(service.slug)}>{service.name.toLowerCase()}</a>.
    </p>
  </Section>

  {
    content.areasServed.length > 0 ? (
      <Section id="areas" title={`Areas in ${city.displayName}`} tone="tint">
        <BulletList items={content.areasServed} />
      </Section>
    ) : null
  }

  <Section id="how-it-works" title="How direct hiring works" tone="tint">
    <StepsInline
      steps={marketplaceSteps}
      moreHref={`${servicePath(service.slug)}#how-it-works`}
      moreLabel={`How hiring ${service.roleWithArticle} works, step by step`}
    />
  </Section>

  <Section id="plans" title="Plans for contacting helpers">
    <PlansLine fallbackHref={`${servicePath(service.slug)}#plans`} />
  </Section>

  <Section id="verification" title="Helper verification" tone="tint">
    <VerificationSummary compact />
  </Section>

  <Section id="faqs" title={`${service.shortName} in ${city.name}: frequently asked questions`}>
    <FaqList faqs={content.localFaqs} />
  </Section>
</div>

{
  counterpartBuilt ? (
    <CrossLink
      targetModel="onDemand"
      href={serviceCityPath(service.slug, city.slug, "onDemand")}
      heading={`Need help in ${city.name} for just a few hours?`}
      body={`You can also book ${service.onDemand.bookingNoun} in ${city.name} through the MeeHelp app — instantly or for a scheduled time.`}
      label={`${service.onDemand.shortName} in ${city.name}`}
    />
  ) : null
}

<div data-model="marketplace">
  <AppDownloadSection
    model="marketplace"
    placement={`${placement}_app_section`}
    title={content.localCta.heading}
    body={content.localCta.body}
  />

  {
    otherServicesHere.length > 0 || sameServiceElsewhere.length > 0 ? (
      <Section id="related" title="Related pages" boilerplate>
        <div class="two-col">
          {otherServicesHere.length > 0 ? (
            <div>
              <h3>Other helpers in {city.name}</h3>
              <LinkList
                links={otherServicesHere.map((sc) => ({
                  href: serviceCityPath(sc.service, sc.city),
                  label: `${getService(sc.service)?.name} in ${city.name}`,
                }))}
              />
            </div>
          ) : null}
          {sameServiceElsewhere.length > 0 ? (
            <div>
              <h3>{service.name} in other cities</h3>
              <LinkList
                links={sameServiceElsewhere.map((sc) => ({
                  href: serviceCityPath(sc.service, sc.city),
                  label: `${service.shortName} in ${cityName(sc.city)}`,
                }))}
              />
            </div>
          ) : null}
        </div>
      </Section>
    ) : null
  }
</div>
