---
/**
 * Consumer plan summary for marketplace pages: HOME plans only.
 * Office and Business plans appear only on the pricing page.
 * Promotions (e.g. free profile views) are deliberately not mentioned.
 */
import { isPricingBuilt } from "@/lib/content";
import { pricingPath } from "@/lib/content/paths";
import PlanCards from "./PlanCards.astro";

interface Props {
  placement: string;
  linkToAllPlans?: boolean;
}

const { placement, linkToAllPlans = true } = Astro.props;
const pricingBuilt = isPricingBuilt();
---

<div class="plans-summary">
  <p>
    Choose a plan for the number of helpers you want to contact. Each contact gives you one helper's contact
    details, so you can call them directly. The plan is paid to MeeHelp; you agree the helper's salary with them yourself.
  </p>
  <PlanCards segment="home" placement={placement} />
  {
    pricingBuilt && linkToAllPlans ? (
      <p class="note">
        Hiring for an office or business? <a href={pricingPath}>See all MeeHelp plans</a>.
      </p>
    ) : null
  }
</div>
