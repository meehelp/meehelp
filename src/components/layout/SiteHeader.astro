---
/**
 * Header navigation, grouped by proposition. Links appear only for pages that
 * are built for the current stage (production currently has none), so there
 * are never empty landmarks or links to missing pages.
 */
import { business } from "@/data/business";
import { getBuiltServices, pricingPageStatus } from "@/lib/content";
import { pricingPath, servicePath } from "@/lib/content/paths";
import { isBuilt } from "@/lib/content/publishing";

const hire = getBuiltServices(undefined, "marketplace");
const book = getBuiltServices(undefined, "onDemand");
const pricingBuilt = isBuilt(pricingPageStatus());
const hasNav = hire.length > 0 || book.length > 0 || pricingBuilt;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${business.brandName} home`}>
      <img
        src={business.logo.src}
        width={business.logo.width}
        height={business.logo.height}
        alt={business.logo.alt}
        fetchpriority="high"
      />
    </a>

    {
      hasNav ? (
        <nav aria-label="Main" class="site-nav site-nav--desktop">
          <ul>
            {hire.map((s) => (
              <li>
                <a href={servicePath(s.slug)}>{s.shortName}</a>
              </li>
            ))}
            {book.length > 0 ? (
              <li>
                <a href="/#on-demand">Hourly help</a>
              </li>
            ) : null}
            {pricingBuilt ? (
              <li>
                <a href={pricingPath}>Plans</a>
              </li>
            ) : null}
          </ul>
        </nav>
      ) : null
    }

    <a href="#get-the-app" class="button button--small site-header__cta">Get the app</a>

    {/* No-JS mobile menu: native <details> is keyboard and screen-reader accessible. */}
    <details class="site-nav site-nav--mobile">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"></span>
        <span class="site-nav__label">Menu</span>
      </summary>
      <nav aria-label="Main (mobile)">
        {
          hire.length > 0 ? (
            <>
              <p class="site-nav__group">Find and hire</p>
              <ul>
                {hire.map((s) => (
                  <li>
                    <a href={servicePath(s.slug)}>{s.name}</a>
                  </li>
                ))}
              </ul>
            </>
          ) : null
        }
        {
          book.length > 0 ? (
            <>
              <p class="site-nav__group">Book by the hour</p>
              <ul>
                {book.map((s) => (
                  <li>
                    <a href={servicePath(s.slug, "onDemand")}>{s.onDemand.name}</a>
                  </li>
                ))}
              </ul>
            </>
          ) : null
        }
        <ul>
          {
            pricingBuilt ? (
              <li>
                <a href={pricingPath}>Plans</a>
              </li>
            ) : null
          }
          <li>
            <a href="#get-the-app">Get the app</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
