---
/**
 * Footer: brand, app links and the hubs for each proposition. City pages are
 * linked from their hubs and from each other — not dumped into every footer.
 */
import { business } from "@/data/business";
import StoreButtons from "@/components/app/StoreButtons.astro";
import { getBuiltServices, pricingPageStatus } from "@/lib/content";
import { pricingPath, servicePath } from "@/lib/content/paths";
import { isBuilt } from "@/lib/content/publishing";

const hire = getBuiltServices(undefined, "marketplace");
const book = getBuiltServices(undefined, "onDemand");
const pricingBuilt = isBuilt(pricingPageStatus());
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <img
        src={business.logo.src}
        width={155}
        height={60}
        alt={business.logo.alt}
        loading="lazy"
        class="site-footer__logo"
      />
      <p class="site-footer__summary">{business.summary}</p>
      <StoreButtons placement="footer" />
    </div>

    {
      hire.length > 0 ? (
        <nav aria-labelledby="footer-hire">
          <h2 id="footer-hire" class="site-footer__heading">
            Find and hire
          </h2>
          <ul>
            {hire.map((s) => (
              <li>
                <a href={servicePath(s.slug)}>{s.name}</a>
              </li>
            ))}
            {pricingBuilt ? (
              <li>
                <a href={pricingPath}>Plans</a>
              </li>
            ) : null}
          </ul>
        </nav>
      ) : null
    }

    {
      book.length > 0 ? (
        <nav aria-labelledby="footer-book">
          <h2 id="footer-book" class="site-footer__heading">
            Book by the hour
          </h2>
          <ul>
            {book.map((s) => (
              <li>
                <a href={servicePath(s.slug, "onDemand")}>{s.onDemand.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      ) : null
    }

    {
      business.contact.email.enabled ? (
        <div>
          <h2 class="site-footer__heading">Contact</h2>
          <p>
            <a href={`mailto:${business.contact.email.value}`}>{business.contact.email.value}</a>
          </p>
        </div>
      ) : null
    }
  </div>
  <div class="container site-footer__legal">
    <p>© {year} {business.legalName ?? business.brandName}</p>
  </div>
</footer>
