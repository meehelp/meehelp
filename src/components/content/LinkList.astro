---
export interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  links: LinkItem[];
  label?: string;
}

const { links, label } = Astro.props;
---

{
  links.length > 0 ? (
    <ul class="link-list" aria-label={label}>
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>
  ) : null
}
