---
import Icon from "./Icon.astro";

interface Props {
  items: string[];
  variant?: "check" | "cross";
}

const { items, variant = "check" } = Astro.props;
---

<ul class={`checklist checklist--${variant}`} data-excluded={variant === "cross" ? "" : undefined}>
  {
    items.map((item) => (
      <li>
        <Icon name={variant} size={20} class="checklist__icon" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
