---
/**
 * Service category cards. A card links to its hub page only when that page is
 * built for the current stage; otherwise it is shown as plain text, so the
 * site never links to a page that doesn't exist.
 */
import type { Service } from "@/lib/content/types";
import Icon from "./Icon.astro";

interface Props {
  items: { service: Service; href: string | null }[];
}

const { items } = Astro.props;
---

<ul class="service-cards">
  {
    items.map(({ service: s, href }) => {
      const Tag = href ? "a" : "div";
      return (
        <li>
          <Tag href={href ?? undefined} class={href ? "service-card" : "service-card service-card--static"}>
            <span class="service-card__icon">
              <Icon name={s.icon} size={28} />
            </span>
            <h3 class="service-card__title">{s.name}</h3>
            <span class="service-card__text">{s.summary}</span>
            {href ? (
              <span class="service-card__more">
                More about {s.name.toLowerCase()} <Icon name="arrow" size={16} />
              </span>
            ) : null}
          </Tag>
        </li>
      );
    })
  }
</ul>
