---
/**
 * A configured call to action (labels live in src/data/ctas.ts). Renders a
 * plain link to the in-page app download section today; `data-cta-model` lets
 * the SEO validator check that journeys are not mixed.
 */
import { ctaLabel, ctas, type CtaKey } from "@/data/ctas";

interface Props {
  ctaKey: CtaKey;
  role?: string;
  placement: string;
  variant?: "primary" | "secondary";
}

const { ctaKey, role, placement, variant = "primary" } = Astro.props;
const cta = ctas[ctaKey];
---

<a
  class={`button${variant === "secondary" ? " button--secondary" : ""}`}
  href={cta.destination.anchor}
  data-track="cta_click"
  data-cta={ctaKey}
  data-cta-model={cta.model}
  data-placement={placement}>{ctaLabel(ctaKey, role)}</a>
