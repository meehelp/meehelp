---
/** Decorative inline SVG icon (aria-hidden). Pair with visible text. */
import type { IconName } from "@/lib/content/types";

export type Glyph = IconName | "check" | "cross" | "phone" | "play" | "arrow";

interface Props {
  name: Glyph;
  size?: number;
  class?: string;
}

const paths: Record<Glyph, string> = {
  maid: '<path d="M14 3h4v6l-2 2-2-2z"></path><path d="M16 11v4"></path><path d="M10 21l2-6h8l2 6z"></path><path d="M4 14c1.5 0 2-1 2-2M3 18c2 0 3-1.5 3-3"></path>',
  cook: '<path d="M5 11h14v5a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z"></path><path d="M3 11h18"></path><path d="M9 7c0-1 1-1 1-2s-1-1-1-2M14 7c0-1 1-1 1-2s-1-1-1-2"></path>',
  nanny: '<circle cx="12" cy="9" r="5"></circle><path d="M10 8.5h.01M14 8.5h.01M10.5 11a2 2 0 0 0 3 0"></path><path d="M6 21a6 6 0 0 1 12 0"></path>',
  elder: '<circle cx="11" cy="4.5" r="2"></circle><path d="M11 7v6l-3 8M11 13l3 3v5"></path><path d="M11 9l-3 3M17 12v9M15 12h2"></path>',
  patient: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path><path d="M12 9v5M9.5 11.5h5"></path>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"></path>',
  cross: '<path d="M7 7l10 10M17 7L7 17"></path>',
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2"></rect><path d="M11 18.5h2"></path>',
  play: '<path d="M7 4.5v15l12-7.5z"></path>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"></path>',
};

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
